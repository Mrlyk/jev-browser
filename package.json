{
  "name": "jev-browser-cli",
  "version": "0.1.2",
  "description": "Browser automation CLI for AI agents, powered by the Jev model's millisecond decisions and near-zero inference costs",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "jev-browser": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "libexec",
    "skills",
    "third-party",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.json",
    "README.zh-CN.md",
    "VALIDATION.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/finish-build.mjs",
    "build:core": "node scripts/build-core.mjs",
    "dev": "npm run build && node dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:smoke": "npm run build && node test/smoke.mjs",
    "test:live": "npm run build && node test/live.mjs",
    "test:skills": "npm run build && node test/skills.mjs",
    "check": "tsc --noEmit",
    "publish": "node scripts/publish.mjs",
    "prepack": "npm run build && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrlyk/jev-browser.git"
  },
  "homepage": "https://github.com/Mrlyk/jev-browser#readme",
  "bugs": {
    "url": "https://github.com/Mrlyk/jev-browser/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
