{
  "name": "jev-browser-cli",
  "version": "0.1.3",
  "description": "Interactive browser terminal and automation CLI powered by Jev",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "jev-browser": "dist/cli.js",
    "jevb": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "libexec",
    "skills",
    "third-party",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.json",
    "README.zh-CN.md",
    "VALIDATION.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/finish-build.mjs",
    "build:core": "node scripts/build-core.mjs",
    "dev": "npm ci --no-audit --no-fund && npm run build:core && npm run build && npm link --ignore-scripts --no-audit --no-fund",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:smoke": "npm run build && node test/smoke.mjs",
    "test:live": "npm run build && node test/live.mjs",
    "test:tui": "npm run build && python3 test/interactive-pty.py",
    "test:tui:live": "npm run build && node test/interactive-live.mjs",
    "test:connections": "npm run build && node test/transport-intervals.mjs",
    "test:skills": "npm run build && node test/skills.mjs",
    "check": "tsc --noEmit",
    "publish": "node scripts/publish.mjs",
    "prepack": "npm run build && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrlyk/jev-browser.git"
  },
  "homepage": "https://github.com/Mrlyk/jev-browser#readme",
  "bugs": {
    "url": "https://github.com/Mrlyk/jev-browser/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "undici": "^7.29.1"
  }
}
